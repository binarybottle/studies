# Copy to .env in this directory and fill in. chmod 600. Never commit.
#
# Do not put an inline comment after a value on the same line. Compose strips
# them correctly, but every other way of reading the file does not.

# --- Model ---------------------------------------------------------------
# The vendor's own credential. Which model answers is MSM_LLM_MODEL below.
ANTHROPIC_API_KEY=

# A LiteLLM model id, vendor/model. Recorded on every participant row, so a
# change mid-study is visible in the data rather than silent.
MSM_LLM_MODEL=anthropic/claude-opus-5

# "litellm" for real runs, "fake" for a dry run with a canned responder that
# needs no key and no network.
MSM_LLM_PROVIDER=litellm

# Optional. Route through a LiteLLM proxy instead of calling the vendor:
# set all three, with the model named as the proxy knows it.
# MSM_LLM_API_BASE=https://litellm.your-org.example
# MSM_LLM_API_KEY=sk-...
# MSM_LLM_MODEL=litellm_proxy/claude-opus-5

# Optional. Reasoning effort; unset means "do not send". Setting it roughly
# doubles latency on the lab gateway, which pushes some turns past the 7 s
# thinking-indicator threshold and others not -- a visual difference between
# trials the experiment did not ask for.
# MSM_LLM_EFFORT=

# Optional. Models tried in order if the primary fails. Leave unset if the
# study must not change models mid-session without you knowing.
# MSM_LLM_FALLBACK_MODELS=

# How many model calls may be in flight at once; turns queue beyond this.
# Raise with the vendor rate limit, not before.
MSM_LLM_MAX_CONCURRENCY=32

# --- Prolific ------------------------------------------------------------
# One code per outcome. In Prolific: approve automatically for COMPLETE,
# custom screening with a fixed reward for NO_CONSENT. Never a rejection.
PROLIFIC_CC_COMPLETE=
PROLIFIC_CC_NO_CONSENT=
# Optional. Returned instead of COMPLETE by a finished session that failed
# both attention checks; attach "manually review" in Prolific, never a
# rejection. Unset, those sessions get COMPLETE and the failures are only
# visible in the exports.
PROLIFIC_CC_ATTENTION=

# --- Site ----------------------------------------------------------------
ADMIN_TOKEN=
STUDY_NAME=Scenario conversations pilot
ORG_NAME=Child Mind Institute
CONTACT_EMAIL=olivia.fitzpatrick@childmind.org
DURATION_TEXT=45 to 60 minutes
