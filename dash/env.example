# Copy to .env in this directory and fill in. chmod 600. Never commit.
STUDY_SMS_NUMBER=+1 (507) 431-7807
ORG_NAME=Child Mind Institute
CONTACT_EMAIL=olivia.fitzpatrick@childmind.org
PHONE_HASH_SALT=              # openssl rand -hex 16 -- set once, never rotate
ADMIN_TOKEN=                  # openssl rand -hex 24
PROLIFIC_CC_COMPLETE=
PROLIFIC_CC_ATTENTION=
PROLIFIC_CC_NO_CONSENT=

# Outbound send for the opt-in confirmation message. Until SMS_SEND_URL is
# set, /api/opt-in records each consent and reports the confirmation as
# "unconfigured" rather than claiming it was sent.
#
# SMS_SEND_TOKEN is the Retell dashboard API key. Two things to know: the
# first message is authored by the outbound SMS agent bound to the study
# number, so that agent's begin message must be the confirmation text
# registered with the campaign; and carriers filter outbound A2P messages
# until the campaign is approved, so a "sent" result before approval means
# accepted by Retell, not delivered to the handset.
SMS_SEND_URL=https://api.retellai.com/create-sms-chat
SMS_SEND_TOKEN=

# Retell dashboard API key, and the chat agent it authenticates against.
# SMS_SEND_TOKEN above is the same key; it is named separately only because
# the send adapter predates the rest. The agent id is not a secret -- it is
# useless without the key -- so it is checked in here rather than left blank.
RETELL_API_KEY=
RETELL_AGENT_ID=agent_ffd9f3ee004a2f91bd92bbc378

# Where the opt-in page is published. OPTIN_PAGE_ORIGIN is the only origin
# allowed to POST to /api/opt-in from a browser; if the page moves, change it
# here or the submission is blocked by CORS.
OPTIN_PAGE_URL=https://matter.childmind.org/studies/dash/opt-in/
OPTIN_PAGE_ORIGIN=https://matter.childmind.org
